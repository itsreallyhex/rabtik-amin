# Copy to .env.local for local dev, and add the same names in Vercel > Project > Settings > Environment Variables.
# Names are case-sensitive.

# VirusTotal (primary URL scanner)
VirusToolKey=

# Google Safe Browsing (fallback URL scanner)
SafeBrowsingKey=

# Google Gemini (primary AI explanation)
GeminiKey=

# Groq (fallback AI explanation)
Groqkey=
